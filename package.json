{
  "name": "b2-worker",
  "description": "A Cloudflare Worker to support download files from Backblaze B2",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 8787",
    "upload": "wrangler versions upload"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "date-fns-tz": "^3.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "wrangler": "^4.159.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "error"
    }
  }
}
