{
  "name": "b2-worker",
  "description": "A Cloudflare Worker to support download files from Backblaze B2",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 8787",
    "upload": "wrangler versions upload"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "date-fns-tz": "^3.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "wrangler": "^4.54.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "error"
    }
  }
}
